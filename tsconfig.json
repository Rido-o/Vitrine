{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "lib": ["ESNext"],
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "gnim/gtk4",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"]
}
